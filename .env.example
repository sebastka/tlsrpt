# IMAP mailbox receiving the TLSRPT reports (rua=mailto:...)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=tlsrpt@example.com
IMAP_PASSWORD=change-me
IMAP_DIR=INBOX
# IMAP_TLS=true                        # default: true on port 993, STARTTLS otherwise
# IMAP_TLS_REJECT_UNAUTHORIZED=true
# IMAP_MAX_MESSAGE_BYTES=26214400

# MariaDB (compose.yaml provides one for development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tlsrpt
DB_PASSWORD=tlsrpt
DB_NAME=tlsrpt
# DB_POOL_SIZE=5
# DB_TLS=false

# HTTP
# LISTEN_HOST=127.0.0.1                # use 0.0.0.0 in containers
# PORT=3000
# SYNC_INTERVAL_MINUTES=30             # 0 = only manual / CLI sync

# OIDC login (required: the dashboard does not start without it)
# Register the redirect URI ${PUBLIC_URL}/auth/callback and post-logout URI ${PUBLIC_URL}/
PUBLIC_URL=https://tlsrpt.example.com   # external origin, no path
OIDC_ISSUER=https://idp.example.com/realms/example
OIDC_CLIENT_ID=tlsrpt
OIDC_CLIENT_SECRET=change-me
# OIDC_TOKEN_AUTH_METHOD=client_secret_basic  # or client_secret_post, client_secret_jwt, none (public client, no secret)
OIDC_ALLOWED_GROUPS=tlsrpt-admins      # comma/space separated; members of any of them get in
# OIDC_GROUPS_CLAIM=groups             # or a nested path, e.g. realm_access.roles
# OIDC_SCOPES=openid profile email     # some providers need "groups" added to send the claim
# SESSION_TTL_HOURS=12
#
# Local mock provider (docker compose --profile oidc up -d); enter the claims
# {"groups": ["tlsrpt-admins"]} on its login form:
# PUBLIC_URL=http://localhost:5173
# OIDC_ISSUER=http://localhost:8080/default
# OIDC_CLIENT_ID=tlsrpt
# OIDC_CLIENT_SECRET=anything
# OIDC_ALLOW_INSECURE_ISSUER=true

# Integration tests (npm test) against the compose MariaDB; unset to skip them
# TEST_DB_HOST=127.0.0.1
# TEST_DB_USER=tlsrpt
# TEST_DB_PASSWORD=tlsrpt
# TEST_DB_NAME=tlsrpt_test
